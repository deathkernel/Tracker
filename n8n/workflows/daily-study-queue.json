{
  "name": "UPSC Tracker - Daily Study Queue",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 6,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "daily-trigger",
      "name": "Daily 06:00 IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT spe.study_date, spe.phase, spe.status, spe.mcq_target, s.name AS subject, t.title AS topic, t.topic_key FROM study_plan_entries spe JOIN topics t ON t.id = spe.topic_id JOIN subjects s ON s.id = t.subject_id WHERE spe.study_date = (NOW() AT TIME ZONE 'Asia/Kolkata')::date ORDER BY CASE spe.phase WHEN 'study' THEN 1 WHEN 'revision' THEN 2 ELSE 3 END, s.sort_order, t.sort_order;",
        "options": {}
      },
      "id": "pg-daily",
      "name": "Fetch Today's Plan",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        500,
        300
      ],
      "credentials": {
        "postgres": {
          "name": "Tracker PostgreSQL"
        }
      }
    }
  ],
  "connections": {
    "Daily 06:00 IST": {
      "main": [
        [
          {
            "node": "Fetch Today's Plan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "timezone": "Asia/Kolkata",
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
